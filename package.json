{
  "name": "default",
  "type": "module",
  "version": "1.0.1",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "build:fix-sitemap": "node ./scripts/fix-sitemap.ts",
    "build:copy-dir": "node ./scripts/copy-dir.ts",
    "build:format1": "npx prettier --write ./build/**/*.html",
    "build:format2": "npx biome format --write ./build",
    "preview": "astro preview",
    "astro": "astro",
    "postbuild": "npm run build:fix-sitemap && npm run build:copy-dir && npm run build:format1 && npm run build:format2"
  },
  "dependencies": {
    "astro": "^7.2.8"
  },
  "devDependencies": {
    "@astrojs/sitemap": "^3.7.3",
    "@biomejs/biome": "^2.5.8",
    "autoprefixer": "^10.5.4",
    "glob": "^13.0.6",
    "postcss": "^8.5.26",
    "prettier": "^3.9.6",
    "prettier-vscode": "^1.0.0",
    "sass": "^1.92.0",
    "stylelint": "^17.14.1",
    "stylelint-config-recommended-scss": "^17.0.1",
    "stylelint-order": "^8.1.1",
    "stylelint-scss": "^7.2.0"
  },
  "browserslist": [
    "last 2 versions",
    "not dead"
  ],
  "allowScripts": {
    "@parcel/watcher": true,
    "esbuild": true
  }
}
